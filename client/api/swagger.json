{
  "openapi": "3.1.1",
  "info": {
    "title": "GetDocument.Insider API",
    "version": "v1.0.0"
  },
  "paths": {
    "/api/postcodes/process": {
      "post": {
        "tags": [
          "Postcodes"
        ],
        "operationId": "ProcessPostcode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessPostcode_Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The request was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessPostcode_Response"
                }
              }
            }
          },
          "404": {
            "description": "The requested resource was not found.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "An upstream service gateway error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/postcodes/processed": {
      "post": {
        "tags": [
          "Postcodes"
        ],
        "operationId": "SearchProcessedPostcodes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchProcessedPostcodes_Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchProcessedPostcodes_Response"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DictionaryOfStringAndDecimal": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "format": "double"
        }
      },
      "ListOfEPCAssessmentResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SearchProcessedPostcodes_EPCAssessmentResponse"
        }
      },
      "ListOfPostcodeResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SearchProcessedPostcodes_PostcodeResponse"
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ],
            "default": "https://www.rfc-editor.org/rfc/rfc7231#section-6.5.1"
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "default": "One or more validation errors occurred."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "default": 400
          },
          "instance": {
            "type": "string",
            "default": "/api/route"
          },
          "traceId": {
            "type": "string",
            "default": "0HMPNHL0JHL76:00000001"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ],
            "description": "the details of the error"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "the name of the error or property of the dto that caused the error",
                  "default": "Error or field name"
                },
                "reason": {
                  "type": "string",
                  "description": "the reason for the error",
                  "default": "Error reason"
                },
                "code": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "the code of the error"
                },
                "severity": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "the severity of the error"
                }
              },
              "description": "the error details object"
            }
          }
        },
        "description": "RFC9457 compatible problem details/ error response class. this can be used by configuring startup like so:\n```app.UseFastEndpoints(c =&gt; c.Errors.UseProblemDetails())```"
      },
      "ProcessPostcode_Request": {
        "required": [
          "postcode"
        ],
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "refreshEPCData": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ProcessPostcode_Response": {
        "required": [
          "postcode",
          "message"
        ],
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SearchProcessedPostcodes_EPCAssessmentAggregationResponse": {
        "required": [
          "totalAssessments",
          "percentageExpired",
          "percentageExpiringInNextYear",
          "epcRatingPercentages"
        ],
        "type": "object",
        "properties": {
          "totalAssessments": {
            "type": "integer",
            "format": "int32"
          },
          "percentageExpired": {
            "type": "number",
            "format": "double"
          },
          "percentageExpiringInNextYear": {
            "type": "number",
            "format": "double"
          },
          "epcRatingPercentages": {
            "$ref": "#/components/schemas/DictionaryOfStringAndDecimal"
          }
        }
      },
      "SearchProcessedPostcodes_EPCAssessmentResponse": {
        "required": [
          "epcAssessmentId",
          "addressLine",
          "epcRating",
          "uniquePropertyReferenceNumber",
          "certificateNumber",
          "registrationDate",
          "isLatest",
          "isExpired",
          "isExpiringInNextYear"
        ],
        "type": "object",
        "properties": {
          "epcAssessmentId": {
            "type": "integer",
            "format": "int64"
          },
          "addressLine": {
            "type": "string"
          },
          "epcRating": {
            "type": [
              "null",
              "string"
            ]
          },
          "uniquePropertyReferenceNumber": {
            "type": "string"
          },
          "certificateNumber": {
            "type": "string"
          },
          "registrationDate": {
            "type": "string",
            "format": "date-time"
          },
          "isLatest": {
            "type": "boolean"
          },
          "isExpired": {
            "type": "boolean"
          },
          "isExpiringInNextYear": {
            "type": "boolean"
          }
        }
      },
      "SearchProcessedPostcodes_LSOADeprivationResponse": {
        "required": [
          "multipleDeprivationPercentage",
          "multipleDeprivationRank",
          "incomeDeprivationPercentage",
          "incomeDeprivationRank",
          "employmentDeprivationPercentage",
          "employmentDeprivationRank",
          "barriersToHousingAndServicesPercentage",
          "barriersToHousingAndServicesRank"
        ],
        "type": "object",
        "properties": {
          "multipleDeprivationPercentage": {
            "type": "number",
            "format": "double"
          },
          "multipleDeprivationRank": {
            "type": "integer",
            "format": "int32"
          },
          "incomeDeprivationPercentage": {
            "type": "number",
            "format": "double"
          },
          "incomeDeprivationRank": {
            "type": "integer",
            "format": "int32"
          },
          "employmentDeprivationPercentage": {
            "type": "number",
            "format": "double"
          },
          "employmentDeprivationRank": {
            "type": "integer",
            "format": "int32"
          },
          "barriersToHousingAndServicesPercentage": {
            "type": "number",
            "format": "double"
          },
          "barriersToHousingAndServicesRank": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SearchProcessedPostcodes_PostcodeResponse": {
        "required": [
          "postcode",
          "lsoaDeprivation",
          "epcAggregation",
          "epcAssessments"
        ],
        "type": "object",
        "properties": {
          "postcode": {
            "type": "string"
          },
          "lsoaDeprivation": {
            "$ref": "#/components/schemas/SearchProcessedPostcodes_LSOADeprivationResponse"
          },
          "epcAggregation": {
            "$ref": "#/components/schemas/SearchProcessedPostcodes_EPCAssessmentAggregationResponse"
          },
          "epcAssessments": {
            "$ref": "#/components/schemas/ListOfEPCAssessmentResponse"
          }
        }
      },
      "SearchProcessedPostcodes_Request": {
        "required": [
          "postcodeSearchTerm"
        ],
        "type": "object",
        "properties": {
          "postcodeSearchTerm": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SearchProcessedPostcodes_Response": {
        "required": [
          "postcodes"
        ],
        "type": "object",
        "properties": {
          "postcodes": {
            "$ref": "#/components/schemas/ListOfPostcodeResponse"
          }
        }
      }
    },
    "securitySchemes": {
      "JWTBearerAuth": {
        "type": "http",
        "description": "Enter a JWT token to authorize the requests...",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}